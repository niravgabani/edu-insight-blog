# Copy this file to .env and fill in your values.

# MongoDB connection URL (MongoDB Atlas or your own server), e.g.
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/edu_blog?retryWrites=true&w=majority
MONGODB_URI=

# Optional: database name (otherwise taken from the URL, or "edu_blog")
# MONGODB_DB=edu_blog

# Optional: API port (default 5000)
# PORT=5000

# Optional: store images on Cloudinary instead of server/uploads (needed on hosts without a
# permanent disk, e.g. Render free). Cloudinary dashboard → API Keys → "API environment variable".
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Daily AI articles (scripts/daily-posts.js) — usually set as GitHub Actions secrets instead
# ANTHROPIC_API_KEY=
# PEXELS_API_KEY=
# DAILY_POSTS_COUNT=15
# DAILY_POSTS_STATUS=published
